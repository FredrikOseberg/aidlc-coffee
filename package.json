{
  "name": "aidlc-coffee",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/write-version.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.functions.json",
    "pages:dev": "npm run build && wrangler pages dev dist --d1 DB --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply aidlc-coffee --local",
    "db:seed:local": "node scripts/seed.mjs > .seed.sql && wrangler d1 execute aidlc-coffee --local --file .seed.sql"
  },
  "dependencies": {
    "@unleash/proxy-client-react": "^6.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "unleash-proxy-client": "^3.8.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
